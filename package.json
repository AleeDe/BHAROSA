{
  "name": "digital-shield",
  "version": "0.1.0",
  "description": "WhatsApp-based security bot MVP (scaffold only).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:text": "tsx src/testTextAnalyzer.ts",
    "test:image": "tsx src/testImageAnalyzer.ts",
    "test:url": "tsx src/testUrlAnalyzer.ts",
    "test:combined": "tsx src/testCombinedAnalysis.ts",
    "test:imageurl": "tsx src/testImageUrlAnalysis.ts"
  },
  "type": "module",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.6.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "private": true
}
